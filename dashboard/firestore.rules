rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// CNC Electric — Firestore Security Rules
//
// Deploy via:
//   1. Firebase Console > Firestore Database > Rules tab > paste this > Publish
//   OR
//   2. From C:\CNC-Bot\dashboard:  firebase deploy --only firestore:rules
//
// What it does:
//   - Blocks ALL read/write access to anyone who is not signed in
//   - Bot writes via Firebase Admin SDK bypass these rules (server-side
//     uses service account credentials, not user auth)
//   - Future: add role-based access (admin vs sales rep) using custom claims
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated users can read & write specific collections
    match /clients/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /payments/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /approvals/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /policy/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /salespersons/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /audit_log/{doc=**} {
      // Audit logs: read-only for users, only bot/admin can write
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
