# ═══════════════════════════════════════════════════════════════
# CNC-Bot .env.example
# Copy to .env and fill in real values.
# .env is gitignored — never commit real values.
# ═══════════════════════════════════════════════════════════════

# ── Anthropic Claude API ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx

# ── Boss WhatsApp Numbers ─────────────────────────────────────
MUDDASIR_NUMBER=923228064444
AWAIS_NUMBER=923004755563

# ── WhatsApp Group Names ──────────────────────────────────────
PAYMENTS_GROUP=Payments
INVOICE_GROUP=CS INVOICES APPROVAL
ACCOUNT_GROUP=Account

# ── Bot Settings ──────────────────────────────────────────────
DISCOUNT_THRESHOLD=25

# ── Firebase Admin SDK (Firestore sync) ───────────────────────
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./credentials/firebase-service-account.json
